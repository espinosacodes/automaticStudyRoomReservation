{
  "name": "reservation",
  "account_id": "b080a52ee18c00011e5ed3b151545943",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "reservation.getcuria.us",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  // 00:05 and 02:05 America/Bogota, Monday to Friday. Each account may hold
  // only 2 hours of reservations dated today or later, so the run books the
  // same day right after midnight. The second tick retries failed blocks.
  "triggers": { "crons": ["5 5,7 * * MON-FRI"] }
}

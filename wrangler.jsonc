{
  "name": "reservation",
  "account_id": "b080a52ee18c00011e5ed3b151545943",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "reservation.getcuria.us",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  // 20:30 and 22:30 America/Bogota, Sunday to Thursday (UTC Monday to Friday).
  // Each account may hold only 2 hours of pending bookings, so tomorrow can be
  // booked only after today's blocks end. The second tick retries failures.
  "triggers": { "crons": ["30 1,3 * * MON-FRI"] }
}
